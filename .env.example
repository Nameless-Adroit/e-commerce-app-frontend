# Copy this file to .env and set your laptop's Wi-Fi / LAN IP address so your phone can reach the backend.
# Do not put passwords, JWT secrets, database credentials, or API secrets here:
# EXPO_PUBLIC_* values are bundled into the mobile/web application.

# Primary LAN host address (change to your laptop's current IPv4 address, e.g. 192.168.0.13)
EXPO_PUBLIC_API_URL=http://192.168.0.13:3000
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.13:3000/api
